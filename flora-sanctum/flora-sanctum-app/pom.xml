<?xml version="1.0" encoding="UTF-8"?>
<project xmlns="http://maven.apache.org/POM/4.0.0"
         xmlns:xsi="http://www.w3.org/2001/XMLSchema-instance"
         xsi:schemaLocation="http://maven.apache.org/POM/4.0.0 http://maven.apache.org/xsd/maven-4.0.0.xsd">
    <modelVersion>4.0.0</modelVersion>

    <parent>
        <groupId>io.gitee.visual0zz</groupId>
        <artifactId>flora-sanctum</artifactId>
        <version>0.1</version>
    </parent>

    <artifactId>flora-sanctum-app</artifactId>

    <dependencies>
        <dependency>
            <groupId>io.gitee.visual0zz</groupId>
            <artifactId>flora-sanctum-core</artifactId>
            <version>${project.version}</version>
        </dependency>
        <!-- 命令框架基座（复用 flora-shell，不重复建设） -->
        <dependency>
            <groupId>io.gitee.visual0zz</groupId>
            <artifactId>flora-shell</artifactId>
            <version>${project.version}</version>
        </dependency>
        <!-- 现代扁平外观 -->
        <dependency>
            <groupId>com.formdev</groupId>
            <artifactId>flatlaf</artifactId>
            <version>3.6</version>
        </dependency>
        <!-- 纯 Java SVG 渲染（SVG Salamander），用于文件夹/条目矢量图标 -->
        <dependency>
            <groupId>com.github.weisj</groupId>
            <artifactId>jsvg</artifactId>
            <version>2.0.0</version>
        </dependency>
    </dependencies>

    <build>
        <plugins>
            <plugin>
                <groupId>org.apache.maven.plugins</groupId>
                <artifactId>maven-jar-plugin</artifactId>
                <configuration>
                    <archive>
                        <manifest>
                            <mainClass>com.flora.sanctum.app.Main</mainClass>
                        </manifest>
                    </archive>
                </configuration>
            </plugin>
            <!-- 复制第三方依赖到 target/lib，供 module-path / jlink 使用 -->
            <plugin>
                <groupId>org.apache.maven.plugins</groupId>
                <artifactId>maven-dependency-plugin</artifactId>
                <version>3.7.1</version>
                <executions>
                    <execution>
                        <id>copy-deps</id>
                        <phase>prepare-package</phase>
                        <goals>
                            <goal>copy-dependencies</goal>
                        </goals>
                        <configuration>
                            <outputDirectory>${project.build.directory}/lib</outputDirectory>
                            <includeScope>runtime</includeScope>
                        </configuration>
                    </execution>
                </executions>
            </plugin>
            <!-- jlink 打包精简 JRE（纯 JDK，无 JavaFX，可免装 Java） -->
            <plugin>
                <groupId>org.apache.maven.plugins</groupId>
                <artifactId>maven-jlink-plugin</artifactId>
                <version>3.1.0</version>
                <configuration>
                    <launcher>sanctum=com.flora.sanctum.app/com.flora.sanctum.app.Main</launcher>
                    <modulePaths>
                        <modulePath>${project.build.directory}/lib</modulePath>
                    </modulePaths>
                    <addModules>com.flora.sanctum.app</addModules>
                </configuration>
            </plugin>
        </plugins>
    </build>
</project>
