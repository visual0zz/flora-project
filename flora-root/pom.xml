<?xml version="1.0" encoding="UTF-8"?>
<project xmlns="http://maven.apache.org/POM/4.0.0"
         xmlns:xsi="http://www.w3.org/2001/XMLSchema-instance"
         xsi:schemaLocation="http://maven.apache.org/POM/4.0.0 http://maven.apache.org/xsd/maven-4.0.0.xsd">
    <modelVersion>4.0.0</modelVersion>

    <parent>
        <groupId>io.gitee.visual0zz</groupId>
        <artifactId>flora-project</artifactId>
        <version>0.1</version>
    </parent>

    <artifactId>flora-root</artifactId>

    <profiles>
        <profile>
            <id>regenerate</id>
            <build>
                <plugins>
                    <plugin>
                        <groupId>io.gitee.visual0zz</groupId>
                        <artifactId>flora-ramet-plugin</artifactId>
                        <version>${project.version}</version>
                        <executions>
                            <execution>
                                <id>ramet-codegen</id>
                                <phase>generate-sources</phase>
                                <goals>
                                    <goal>generate</goal>
                                </goals>
                                <configuration>
                                    <templatesDir>${project.basedir}/src/main/templates</templatesDir>
                                    <outputDir>${project.basedir}/src/main/java</outputDir>
                                </configuration>
                            </execution>
                        </executions>
                    </plugin>
                </plugins>
            </build>
        </profile>
        <!-- 可选综合检查：当本地仓库已安装 flora-osmetes 库时激活，
             用 osmetes-plugin 在 validate 阶段扫描整个仓库（编码、密钥、Tab、行尾空白 trailing-whitespace 等），
             尽早发现问题，避免后续编译/测试/打包在错误文件上浪费成本。
             扫描范围覆盖仓库根目录（maven.multiModuleProjectDirectory），覆盖全部子模块。
             可用 <disabledChecks> 关闭若干检查项（名称取并集，分隔符 ,;|& 任意），
             例如 <disabledChecks>secret;tab</disabledChecks> 仅关闭密钥与 Tab 检查。
             还可用 <checkConfig> 给各检查项下发其自定义配置，例如允许编码检查额外接受 GBK：
             <checkConfig><encoding.allowed>UTF-8;GBK</encoding.allowed></checkConfig>。 -->
        <profile>
            <id>osmetes-check</id>
            <activation>
                <file>
                    <exists>${user.home}/.m2/repository/io/gitee/visual0zz/flora-osmetes/0.1/flora-osmetes-0.1.jar</exists>
                </file>
            </activation>
            <build>
                <plugins>
                    <plugin>
                        <groupId>io.gitee.visual0zz</groupId>
                        <artifactId>flora-osmetes-plugin</artifactId>
                        <version>${project.version}</version>
                        <executions>
                            <execution>
                                <id>osmetes-check</id>
                                <phase>validate</phase>
                                <goals>
                                    <goal>check</goal>
                                </goals>
                                <configuration>
                                    <sourceRoot>${maven.multiModuleProjectDirectory}</sourceRoot>
                                    <!-- 额外忽略规则：忽略所有含 absent 目录的路径与所有 .log 文件 -->
                                    <ignorePatterns>absent/;*.log</ignorePatterns>
                                </configuration>
                            </execution>
                        </executions>
                    </plugin>
                </plugins>
            </build>
        </profile>
    </profiles>
</project>
