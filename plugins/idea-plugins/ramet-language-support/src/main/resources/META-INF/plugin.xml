<?xml version="1.0" encoding="UTF-8"?>
<idea-plugin>
    <id>io.gitee.visual0zz.ramet</id>
    <name>Ramet Language Support</name>
    <!-- 占位版本：实际版本由构建时从 git tag 注入(见 build.gradle.kts pluginConfiguration.version)，此处字面量不参与发布产物。 -->
    <version>0.0.0</version>
    <vendor email="indiancarriernoac@qq.com" url="https://gitee.com/visual0zz">flora</vendor>

    <icon main="pluginIcon.svg"/>

    <description><![CDATA[
      <h3>Ramet Template Language Support</h3>
      <p>Provides two-level fine-grained syntax highlighting for <code>.ramet</code> template files.</p>
      <h4>Features</h4>
      <ul>
        <li>Syntax highlighting for directive keywords, operators, strings, numbers, and function sections</li>
        <li>Low-saturation dimming for passive text, high-saturation coloring for logic blocks</li>
        <li>Full Lson syntax highlighting for Meta blocks (@Param/@Cartesian/@Path/@Config/@SkipWhen)</li>
      </ul>
    ]]>    </description>

    <depends>com.intellij.modules.platform</depends>

    <extensions defaultExtensionNs="com.intellij">
        <lang.parserDefinition
                language="Ramet"
                implementationClass="com.flora.ramet.idea.parser.RametParserDefinition"/>

    <fileType
            name="Ramet"
            implementationClass="com.flora.ramet.idea.RametFileType"
            fieldName="INSTANCE"
            language="Ramet"
            extensions="ramet"/>

    <lang.syntaxHighlighterFactory
                language="Ramet"
                implementationClass="com.flora.ramet.idea.highlighter.RametSyntaxHighlighterFactory"/>

        <colorSettingsPage
                implementation="com.flora.ramet.idea.highlighter.RametColorSettingsPage"/>

        <annotator
                language="Ramet"
                implementationClass="com.flora.ramet.idea.highlighter.RametAnnotator"/>

    <additionalTextAttributes
            scheme="Default"
            file="colorSchemes/RametDefault.xml"/>

    <additionalTextAttributes
            scheme="Darcula"
            file="colorSchemes/RametDarcula.xml"/>
    </extensions>
</idea-plugin>
