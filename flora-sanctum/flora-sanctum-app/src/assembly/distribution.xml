<?xml version="1.0" encoding="UTF-8"?>
<assembly xmlns="http://maven.apache.org/ASSEMBLY/2.1.0"
          xmlns:xsi="http://www.w3.org/2001/XMLSchema-instance"
          xsi:schemaLocation="http://maven.apache.org/ASSEMBLY/2.1.0 https://maven.apache.org/xsd/assembly-2.1.0.xsd">
    <!-- flora-sanctum 分发 zip：lib/(应用 jar + 全量依赖) + 多平台启动脚本 + 应用级配置（见设计"形态与启动"） -->
    <id>dist</id>
    <formats>
        <format>zip</format>
    </formats>
    <includeBaseDirectory>true</includeBaseDirectory>
    <baseDirectory>flora-sanctum</baseDirectory>
    <files>
        <!-- 启动脚本（跨平台双头脚本：bash 段 + :windows cmd 段；经 -Dflora.repo 传仓库根，module-path 启动） -->
        <file>
            <source>src/main/resources/script/start.cmd</source>
            <outputDirectory>/</outputDirectory>
            <fileMode>0755</fileMode>
        </file>
        <!-- 应用级默认配置（新建独立仓库时复制为仓库级） -->
        <file>
            <source>src/main/resources/config.json</source>
            <outputDirectory>/</outputDirectory>
        </file>
    </files>
    <fileSets>
        <!-- 全量依赖 jar（maven-dependency-plugin 复制到 target/lib） -->
        <fileSet>
            <directory>${project.build.directory}/lib</directory>
            <outputDirectory>lib</outputDirectory>
            <includes>
                <include>*.jar</include>
            </includes>
        </fileSet>
        <!-- 应用自身 jar -->
        <fileSet>
            <directory>${project.build.directory}</directory>
            <outputDirectory>lib</outputDirectory>
            <includes>
                <include>${project.build.finalName}.jar</include>
            </includes>
        </fileSet>
    </fileSets>
</assembly>
